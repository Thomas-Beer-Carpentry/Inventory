{
  "name": "workshop-inventory",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node tests/phone-store.test.mjs && node tests/scanner.test.mjs && node tests/decode-raster.mjs && node tests/offline.test.mjs && node tests/android-bridge.test.mjs && node tests/browser-setup.test.mjs",
